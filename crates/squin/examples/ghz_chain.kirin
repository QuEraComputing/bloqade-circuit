stage @kernel fn @main(Int) -> Bits[?];

specialize @kernel fn @main(Int) -> Bits[?] cfg {
  ^entry(%size: Int) {
    %zero = constant 0 -> Int;
    %one = constant 1 -> Int;
    %last = sub %size, %one -> Int;
    %r0 = alloc_register %size -> Register[?];
    %r1, %head_slot, %head = borrow %r0, %zero -> Register[?; lent=1];
    %prepared = h %head;
    %r2 = release %r1, %head_slot, %prepared -> Register[?];
    %chain = for %zero in %zero..%last step %one iter_args(%r2) do block ^link(%k: Int, %r: Register[?]) {
      %next = add %k, %one -> Int;
      %r3, %left_slot, %left = borrow %r, %k -> Register[?; lent=1];
      %r4, %right_slot, %right = borrow %r3, %next -> Register[?; lent=2];
      %left_out, %right_out = cx %left, %right;
      %r5 = release %r4, %left_slot, %left_out -> Register[?; lent=1];
      %r6 = release %r5, %right_slot, %right_out -> Register[?];
      yield %r6;
    } -> Register[?];
    %measured, %bits = measure_register %chain -> Register[?], Bits[?];
    free_register %measured;
    ret %bits;
  }
}
