stage @kernel fn @main(Register[?]) -> Bits[?];

specialize @kernel fn @main(Register[?]) -> Bits[?] cfg {
  ^generic(%input: Register[?]) {
    %zero = constant 0 -> Int;
    %one = constant 1 -> Int;
    %r0, %size = length %input -> Register[?];
    %prepared = for %zero in %zero..%size step %one iter_args(%r0) do block ^each(%k: Int, %r: Register[?]) {
      %lent, %slot, %wire = borrow %r, %k -> Register[?; lent=1];
      %h_out = h %wire;
      %whole = release %lent, %slot, %h_out -> Register[?];
      yield %whole;
    } -> Register[?];
    %measured, %bits = measure_register %prepared -> Register[?], Bits[?];
    free_register %measured;
    ret %bits;
  }
}

specialize @kernel fn @main(Register[2]) -> Bits[2] cfg {
  ^pair(%input: Register[2]) {
    %zero = constant 0 -> Int;
    %one = constant 1 -> Int;
    %r1, %left_slot, %left = borrow %input, %zero -> Register[2; lent=1];
    %r2, %right_slot, %right = borrow %r1, %one -> Register[2; lent=2];
    %prepared = h %left;
    %left_out, %right_out = cx %prepared, %right;
    %r3 = release %r2, %left_slot, %left_out -> Register[2; lent=1];
    %r4 = release %r3, %right_slot, %right_out -> Register[2];
    %measured, %bits = measure_register %r4 -> Register[2], Bits[2];
    free_register %measured;
    ret %bits;
  }
}
